{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller-pinned standalone storyboard inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "replacement_bases"],
  "properties": {
    "schema_version": {"const": "storyboard-source-evidence.v1"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "replacement_bases": {"type": "array", "items": {"$ref": "#/$defs/base"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "owner_skill", "version", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "owner_skill": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "artifact_type", "primary_path", "primary_file_sha256", "record_path", "record_file_sha256"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "artifact_type": {"type": "string", "minLength": 1},
        "primary_path": {"type": "string", "minLength": 1},
        "primary_file_sha256": {"$ref": "#/$defs/sha"},
        "record_path": {"type": "string", "minLength": 1},
        "record_file_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_id", "artifact_ref", "file_sha256"],
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "file_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
